# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/

# Generated localization (generated by flutter gen-l10n)
lib/l10n/generated/

# Drift generated files (generated by build_runner).
# NOTE: lib/data/database/database.g.dart is deliberately COMMITTED - a fresh
# clone must be able to compile without running build_runner first, and the
# generated schema is worth reviewing in diffs. Regenerate with:
#   dart run build_runner build --delete-conflicting-outputs --force-jit
lib/**/*.g.dart
!lib/data/database/database.g.dart
lib/**/*.freezed.dart

# OS
Thumbs.db
Desktop.ini

# KnowFlow local data
*.kpak
