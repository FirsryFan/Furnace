import 'dart:io';

import 'package:drift/native.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:furnace/data/database/database.dart';
import 'package:furnace/features/questions/application/question_library_reader.dart';

void main() {
  test('real db: question groups collapse and count', () async {
    final src = File(r'E:\Furnace\data\furnace.db');
    final tmp = await Directory.systemTemp.createTemp('furnace-group-live');
    final copy = await src.copy('${tmp.path}/furnace.db');
    final db = AppDatabase.forTesting(NativeDatabase(copy));
    addTearDown(() async {
      await db.close();
      await tmp.delete(recursive: true);
    });
    final all = await readQuestionLibrary(db, limit: 0);
    final groups = all.entries.where((e) => e.groupSize > 1).toList();
    // ignore: avoid_print
    print('REAL totalEntries=${all.entries.length} groups=${groups.length} '
        'groupRows=${groups.fold<int>(0, (n, e) => n + e.groupSize)}');
    for (final g in groups.take(5)) {
      // ignore: avoid_print
      print('GROUP ${g.questionId} size=${g.groupSize} title=${g.displayTitle}');
    }
    expect(groups, isNotEmpty);
    expect(groups.every((g) => g.groupQuestionIds.length == g.groupSize), isTrue);
  });
}
