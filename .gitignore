# Ignore rules for the Threadflow workspace (public repository).
#
# `app/.gitignore` (from the Flutter template) covers most Dart/Flutter output.
# The rules here add what it misses, and - importantly - UN-ignore the generated
# sources a fresh clone needs in order to build without running code generators.

# --- build output -----------------------------------------------------------
build/
dist/
*.apk
*.aab

# --- Dart / Flutter ---------------------------------------------------------
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
.vscode/

# --- Windows desktop build scaffolding --------------------------------------
# Almost all of app/windows is generated by CMake on first build (311 MB in the
# working copy). Only the checked-in scaffolding belongs in the repository.
app/windows/flutter/ephemeral/
app/windows/**/Debug/
app/windows/**/Release/
app/windows/**/x64/
app/windows/**/*.vcxproj
app/windows/**/*.vcxproj.filters
app/windows/**/*.vcxproj.user
app/windows/**/*.sln

# --- Generated Dart sources -------------------------------------------------
# Drift schema code (database.g.dart) IS committed on purpose: without it a
# fresh clone cannot compile, and the generated schema is reviewable in a diff.
# Regenerate with:
#   cd app && dart run build_runner build --delete-conflicting-outputs --force-jit
!app/lib/data/database/database.g.dart

# --- Localisation -----------------------------------------------------------
# app/lib/l10n/app_localizations*.dart are generated by `flutter gen-l10n` but
# are committed so the project builds without that step. The ARB files are the
# source of truth: app/lib/l10n/app_zh.arb and app/lib/l10n/app_en.arb.

# --- Signing material (NEVER commit in a public repository) -----------------
# The release keystore and its passwords. This repository is PUBLIC, so these
# must stay local. The release signing config in app/build.gradle.kts falls back
# to the debug key when key.properties is missing, so `flutter build apk` still
# works for anyone who clones without them - it just produces a debug-signed
# artifact. See docs/DEPLOY.md for how to create your own keystore.
app/android/key.properties
app/android/*.jks
app/android/*.keystore

# --- Local database / backups ----------------------------------------------
# The live database lives under %APPDATA% (Windows) or the app sandbox
# (Android), so it should never appear here; this guards against a stray copy.
*.db
*.db.bak
*.sqlite
*.sqlite3

# --- Gradle wrapper ---------------------------------------------------------
# `app/android/.gitignore` (Flutter template) excludes the wrapper jar because
# Flutter regenerates the wrapper. It is kept here so `./gradlew` works in a
# fresh clone without an extra bootstrap step.
!app/android/gradle/wrapper/gradle-wrapper.jar

# --- Editor / OS noise ------------------------------------------------------
Thumbs.db
Desktop.ini
*.log
._*.log
